<Project Sdk="Microsoft.NET.Sdk">

  <!-- Player bots for the Homefront dedicated server, a HomefrontSDK mod. Build.ps1 installs it as
       server\Binaries\HomefrontSDK\Mods\HomefrontBots\HomefrontBots.dll. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game already has the SDK loaded: reference it, don't copy it. -->
    <ProjectReference Include="..\HomefrontSDK\SDK\HomefrontSDK.csproj" Private="false" />
  </ItemGroup>

</Project>
