<?xml version="1.0" encoding="utf-8"?>
<!-- HomefrontSDK comes from GitHub Packages, everything else from nuget.org. GitHub's feed needs a token even for
     public packages: CI passes its GITHUB_TOKEN; locally set GITHUB_TOKEN to a personal access token with
     read:packages (or build with -p:UseLocalSdk=true). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/TylerJaacks/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="HomefrontSDK" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="TylerJaacks" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
